#pragma kernel IdentityComposite
#pragma kernel ApplyAdditiveStamp
#pragma kernel ValidationAddConstant

RWTexture2DArray<float> _HeightCache;

Texture2D<float4> _StampTexture;
SamplerState sampler_StampTexture;

int _TargetSlice;
int _SamplesPerSide;

float _SampleSpacing;
float _TileWorldSize;

int2 _TileCoordinate;
float2 _TileWorldOriginXZ;
float2 _WorldSizeXZ;

float2 _StampMinXZ;
float2 _StampSizeXZ;
float _StampHeightDelta;
float _StampFalloff;
float _StampSmoothingRadius;
float _StampSmoothingStrength;

float _ValidationHeightDelta;


// =====================================================
// COMMON ADDRESSING
// =====================================================

bool TryGetAuthoringSample(
    uint3 dispatchThreadId,
    out uint3 cacheAddress,
    out float2 sampleWorldXZ
)
{
    cacheAddress =
        uint3(
            0,
            0,
            0
        );

    sampleWorldXZ =
        float2(
            0.0,
            0.0
        );

    if (
        dispatchThreadId.x >= (uint)_SamplesPerSide
        || dispatchThreadId.y >= (uint)_SamplesPerSide
    )
    {
        return false;
    }

    float2 expectedTileOriginXZ =
        (float2)_TileCoordinate *
        _TileWorldSize;

    float originTolerance =
        max(
            abs(_SampleSpacing) * 0.001,
            0.00001
        );

    if (
        any(
            abs(
                expectedTileOriginXZ -
                _TileWorldOriginXZ
            ) > originTolerance
        )
    )
    {
        return false;
    }

    sampleWorldXZ =
        _TileWorldOriginXZ
        + float2(
            dispatchThreadId.x,
            dispatchThreadId.y
        ) * _SampleSpacing;

    float worldTolerance =
        max(
            abs(_SampleSpacing) * 0.001,
            0.00001
        );

    if (
        sampleWorldXZ.x < -worldTolerance
        || sampleWorldXZ.y < -worldTolerance
        || sampleWorldXZ.x > _WorldSizeXZ.x + worldTolerance
        || sampleWorldXZ.y > _WorldSizeXZ.y + worldTolerance
    )
    {
        return false;
    }

    cacheAddress =
        uint3(
            dispatchThreadId.x,
            dispatchThreadId.y,
            (uint)_TargetSlice
        );

    return true;
}


// =====================================================
// IDENTITY COMPOSITION
// =====================================================

[numthreads(8, 8, 1)]
void IdentityComposite(
    uint3 dispatchThreadId : SV_DispatchThreadID
)
{
    uint3 cacheAddress;
    float2 sampleWorldXZ;

    if (
        !TryGetAuthoringSample(
            dispatchThreadId,
            cacheAddress,
            sampleWorldXZ
        )
    )
    {
        return;
    }

    float height =
        _HeightCache[
            cacheAddress
        ];

    _HeightCache[
        cacheAddress
    ] = height;
}


// =====================================================
// ADDITIVE HEIGHT STAMP
// =====================================================

float CalculateFootprintFalloff(
    float2 stampUV
)
{
    if (_StampFalloff <= 0.0)
    {
        return 1.0;
    }

    float nearestEdge =
        min(
            min(
                stampUV.x,
                1.0 - stampUV.x
            ),
            min(
                stampUV.y,
                1.0 - stampUV.y
            )
        );

    float edgeDistance01 =
        saturate(
            nearestEdge * 2.0
        );

    return
        smoothstep(
            0.0,
            saturate(_StampFalloff),
            edgeDistance01
        );
}

float SampleRawStampWeight(
    float2 stampUV
)
{
    return
        saturate(
            _StampTexture.SampleLevel(
                sampler_StampTexture,
                stampUV,
                0.0
            ).r
        );
}

float GetGaussianWeight1D(
    int coordinate
)
{
    int distance =
        abs(
            coordinate
        );

    if (distance == 0)
    {
        return 6.0;
    }

    if (distance == 1)
    {
        return 4.0;
    }

    return 1.0;
}

float SampleGaussianStampWeight(
    float2 stampUV
)
{
    float safeSizeX =
        max(
            _StampSizeXZ.x,
            0.000001
        );

    float safeSizeZ =
        max(
            _StampSizeXZ.y,
            0.000001
        );

    /*
     * Smoothing radius is authored in WORLD METRES.
     *
     * Five taps per axis are located at:
     * -Radius, -Radius/2, 0, +Radius/2, +Radius.
     *
     * Independent X/Z conversion keeps physical smoothing isotropic even
     * when the stamp footprint itself is rectangular.
     */
    float2 radiusUV =
        float2(
            _StampSmoothingRadius /
                safeSizeX,
            _StampSmoothingRadius /
                safeSizeZ
        );

    float accumulatedValue =
        0.0;

    float accumulatedWeight =
        0.0;

    [unroll]
    for (
        int offsetZ = -2;
        offsetZ <= 2;
        offsetZ++
    )
    {
        float zFactor =
            (float)offsetZ *
            0.5;

        float weightZ =
            GetGaussianWeight1D(
                offsetZ
            );

        [unroll]
        for (
            int offsetX = -2;
            offsetX <= 2;
            offsetX++
        )
        {
            float xFactor =
                (float)offsetX *
                0.5;

            /*
             * Keep the full 5x5 Gaussian topology at every point.
             *
             * The original Stage 16A implementation rejected taps outside
             * UV 0..1 and renormalized the surviving samples. As Radius grew,
             * complete rows/columns crossed the footprint boundary at the
             * discrete Radius / 2 and Radius distances. That changed the
             * effective filter abruptly and produced nested rectangular ridges.
             *
             * Clamp only the SOURCE lookup coordinate instead. Every one of
             * the 25 Gaussian weights remains active everywhere inside the
             * mathematical stamp footprint, so the filter changes continuously.
             *
             * ApplyAdditiveStamp still rejects terrain samples whose central
             * stampUV lies outside 0..1, and footprint Falloff is still applied
             * afterward. This does NOT expand the modifier footprint.
             */
            float2 sampleUV =
                saturate(
                    stampUV
                    +
                    float2(
                        radiusUV.x *
                            xFactor,
                        radiusUV.y *
                            zFactor
                    )
                );

            float weight =
                GetGaussianWeight1D(
                    offsetX
                )
                *
                weightZ;

            accumulatedValue +=
                SampleRawStampWeight(
                    sampleUV
                )
                *
                weight;

            accumulatedWeight +=
                weight;
        }
    }

    if (accumulatedWeight <= 0.0)
    {
        return
            SampleRawStampWeight(
                stampUV
            );
    }

    return
        saturate(
            accumulatedValue /
            accumulatedWeight
        );
}

float SampleFinalStampTextureWeight(
    float2 stampUV
)
{
    float rawWeight =
        SampleRawStampWeight(
            stampUV
        );

    /*
     * Exact legacy fast path. Existing modifiers default to Radius = 0.
     * They therefore retain the original single bilinear sample and pay no
     * Gaussian sampling cost.
     */
    if (
        _StampSmoothingRadius <= 0.0
        || _StampSmoothingStrength <= 0.0
    )
    {
        return rawWeight;
    }

    float smoothedWeight =
        SampleGaussianStampWeight(
            stampUV
        );

    return
        saturate(
            lerp(
                rawWeight,
                smoothedWeight,
                saturate(
                    _StampSmoothingStrength
                )
            )
        );
}

[numthreads(8, 8, 1)]
void ApplyAdditiveStamp(
    uint3 dispatchThreadId : SV_DispatchThreadID
)
{
    uint3 cacheAddress;
    float2 sampleWorldXZ;

    if (
        !TryGetAuthoringSample(
            dispatchThreadId,
            cacheAddress,
            sampleWorldXZ
        )
    )
    {
        return;
    }

    if (
        _StampSizeXZ.x <= 0.0
        || _StampSizeXZ.y <= 0.0
    )
    {
        return;
    }

    float2 stampUV =
        (
            sampleWorldXZ -
            _StampMinXZ
        ) /
        _StampSizeXZ;

    if (
        stampUV.x < 0.0
        || stampUV.x > 1.0
        || stampUV.y < 0.0
        || stampUV.y > 1.0
    )
    {
        return;
    }

    /*
     * Smoothing modifies only the source texture weight. The established
     * footprint falloff is applied afterward, so its spatial contract remains
     * unchanged and the modifier still contributes nowhere outside its bounds.
     */
    float textureWeight =
        SampleFinalStampTextureWeight(
            stampUV
        );

    float footprintFalloff =
        CalculateFootprintFalloff(
            stampUV
        );

    float finalWeight =
        saturate(
            textureWeight
        )
        *
        footprintFalloff;

    float contribution =
        finalWeight *
        _StampHeightDelta;

    _HeightCache[
        cacheAddress
    ] += contribution;
}


// =====================================================
// VALIDATION WRITE
// =====================================================

[numthreads(8, 8, 1)]
void ValidationAddConstant(
    uint3 dispatchThreadId : SV_DispatchThreadID
)
{
    if (
        dispatchThreadId.x >= (uint)_SamplesPerSide
        || dispatchThreadId.y >= (uint)_SamplesPerSide
    )
    {
        return;
    }

    uint3 cacheAddress =
        uint3(
            dispatchThreadId.x,
            dispatchThreadId.y,
            (uint)_TargetSlice
        );

    _HeightCache[
        cacheAddress
    ] += _ValidationHeightDelta;
}
