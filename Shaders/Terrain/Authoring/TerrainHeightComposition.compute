#pragma kernel IdentityComposite
#pragma kernel ApplyAdditiveStamp
#pragma kernel ValidationAddConstant

RWTexture2DArray<float> _HeightCache;

Texture2D<float4> _StampTexture;
SamplerState sampler_StampTexture;

int _TargetSlice;
int _SamplesPerSide;

float _SampleSpacing;
float _TileWorldSize;

int2 _TileCoordinate;
float2 _TileWorldOriginXZ;
float2 _WorldSizeXZ;

float2 _StampMinXZ;
float2 _StampSizeXZ;
float _StampHeightDelta;
float _StampFalloff;

float _ValidationHeightDelta;


// =====================================================
// COMMON ADDRESSING
// =====================================================

bool TryGetAuthoringSample(
    uint3 dispatchThreadId,
    out uint3 cacheAddress,
    out float2 sampleWorldXZ
)
{
    cacheAddress =
        uint3(
            0,
            0,
            0
        );

    sampleWorldXZ =
        float2(
            0.0,
            0.0
        );

    if (
        dispatchThreadId.x >= (uint)_SamplesPerSide
        || dispatchThreadId.y >= (uint)_SamplesPerSide
    )
    {
        return false;
    }

    float2 expectedTileOriginXZ =
        (float2)_TileCoordinate *
        _TileWorldSize;

    float originTolerance =
        max(
            abs(_SampleSpacing) * 0.001,
            0.00001
        );

    if (
        any(
            abs(
                expectedTileOriginXZ -
                _TileWorldOriginXZ
            ) > originTolerance
        )
    )
    {
        return false;
    }

    sampleWorldXZ =
        _TileWorldOriginXZ
        + float2(
            dispatchThreadId.x,
            dispatchThreadId.y
        ) * _SampleSpacing;

    float worldTolerance =
        max(
            abs(_SampleSpacing) * 0.001,
            0.00001
        );

    if (
        sampleWorldXZ.x < -worldTolerance
        || sampleWorldXZ.y < -worldTolerance
        || sampleWorldXZ.x > _WorldSizeXZ.x + worldTolerance
        || sampleWorldXZ.y > _WorldSizeXZ.y + worldTolerance
    )
    {
        return false;
    }

    cacheAddress =
        uint3(
            dispatchThreadId.x,
            dispatchThreadId.y,
            (uint)_TargetSlice
        );

    return true;
}


// =====================================================
// IDENTITY COMPOSITION
// =====================================================

[numthreads(8, 8, 1)]
void IdentityComposite(
    uint3 dispatchThreadId : SV_DispatchThreadID
)
{
    uint3 cacheAddress;
    float2 sampleWorldXZ;

    if (
        !TryGetAuthoringSample(
            dispatchThreadId,
            cacheAddress,
            sampleWorldXZ
        )
    )
    {
        return;
    }

    float height =
        _HeightCache[
            cacheAddress
        ];

    _HeightCache[
        cacheAddress
    ] = height;
}


// =====================================================
// ADDITIVE HEIGHT STAMP
// =====================================================

float CalculateFootprintFalloff(
    float2 stampUV
)
{
    /*
     * Exact deterministic falloff contract:
     *
     * nearestEdge:
     *     0 at any rectangle edge
     *     0.5 at the rectangle center
     *
     * edgeDistance01:
     *     nearestEdge * 2
     *     therefore 0 at edge, 1 at center
     *
     * Falloff == 0:
     *     no additional footprint attenuation
     *
     * Falloff > 0:
     *     smooth fade from the rectangle edge until
     *     edgeDistance01 reaches Falloff
     *
     * Examples:
     *     Falloff 0.25 -> fade over outer 12.5% per side
     *     Falloff 0.50 -> fade over outer 25% per side
     *     Falloff 1.00 -> fade extends edge-to-center
     */
    if (_StampFalloff <= 0.0)
    {
        return 1.0;
    }

    float nearestEdge =
        min(
            min(
                stampUV.x,
                1.0 - stampUV.x
            ),
            min(
                stampUV.y,
                1.0 - stampUV.y
            )
        );

    float edgeDistance01 =
        saturate(
            nearestEdge * 2.0
        );

    return
        smoothstep(
            0.0,
            saturate(_StampFalloff),
            edgeDistance01
        );
}

[numthreads(8, 8, 1)]
void ApplyAdditiveStamp(
    uint3 dispatchThreadId : SV_DispatchThreadID
)
{
    uint3 cacheAddress;
    float2 sampleWorldXZ;

    if (
        !TryGetAuthoringSample(
            dispatchThreadId,
            cacheAddress,
            sampleWorldXZ
        )
    )
    {
        return;
    }

    if (
        _StampSizeXZ.x <= 0.0
        || _StampSizeXZ.y <= 0.0
    )
    {
        return;
    }

    float2 stampUV =
        (
            sampleWorldXZ -
            _StampMinXZ
        ) /
        _StampSizeXZ;

    /*
     * Outside the mathematical rectangle there is no contribution.
     * Do not clamp outside samples into the border texel.
     */
    if (
        stampUV.x < 0.0
        || stampUV.x > 1.0
        || stampUV.y < 0.0
        || stampUV.y > 1.0
    )
    {
        return;
    }

    /*
     * Height-texture semantics are explicitly 0..1. Saturating the
     * sample guarantees the conservative CPU contribution interval:
     *
     *     positive HeightDelta -> [0, HeightDelta]
     *     negative HeightDelta -> [HeightDelta, 0]
     */
    float textureWeight =
        saturate(
            _StampTexture.SampleLevel(
                sampler_StampTexture,
                stampUV,
                0.0
            ).r
        );

    float footprintFalloff =
        CalculateFootprintFalloff(
            stampUV
        );

    float finalWeight =
        textureWeight *
        footprintFalloff;

    float contribution =
        finalWeight *
        _StampHeightDelta;

    _HeightCache[
        cacheAddress
    ] += contribution;
}


// =====================================================
// VALIDATION WRITE
// =====================================================

[numthreads(8, 8, 1)]
void ValidationAddConstant(
    uint3 dispatchThreadId : SV_DispatchThreadID
)
{
    if (
        dispatchThreadId.x >= (uint)_SamplesPerSide
        || dispatchThreadId.y >= (uint)_SamplesPerSide
    )
    {
        return;
    }

    uint3 cacheAddress =
        uint3(
            dispatchThreadId.x,
            dispatchThreadId.y,
            (uint)_TargetSlice
        );

    _HeightCache[
        cacheAddress
    ] += _ValidationHeightDelta;
}
