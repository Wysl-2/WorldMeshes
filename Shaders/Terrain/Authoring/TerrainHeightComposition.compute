#pragma kernel IdentityComposite
#pragma kernel ApplyAdditiveStamp
#pragma kernel ValidationAddConstant

RWTexture2DArray<float> _HeightCache;

Texture2D<float4> _StampTexture;
SamplerState sampler_StampTexture;

int _TargetSlice;
int _SamplesPerSide;

float _SampleSpacing;
float _TileWorldSize;

int2 _TileCoordinate;
float2 _TileWorldOriginXZ;
float2 _WorldSizeXZ;

float2 _StampMinXZ;
float2 _StampSizeXZ;
float _StampHeightDelta;

float _ValidationHeightDelta;


// =====================================================
// COMMON ADDRESSING
// =====================================================

bool TryGetAuthoringSample(
    uint3 dispatchThreadId,
    out uint3 cacheAddress,
    out float2 sampleWorldXZ
)
{
    cacheAddress =
        uint3(
            0,
            0,
            0
        );

    sampleWorldXZ =
        float2(
            0.0,
            0.0
        );

    if (
        dispatchThreadId.x >=
            (uint)_SamplesPerSide
        ||
        dispatchThreadId.y >=
            (uint)_SamplesPerSide
    )
    {
        return false;
    }

    float2 expectedTileOriginXZ =
        (float2)_TileCoordinate *
        _TileWorldSize;

    float originTolerance =
        max(
            abs(_SampleSpacing) *
                0.001,
            0.00001
        );

    if (
        any(
            abs(
                expectedTileOriginXZ -
                _TileWorldOriginXZ
            )
            >
            originTolerance
        )
    )
    {
        return false;
    }

    sampleWorldXZ =
        _TileWorldOriginXZ
        +
        float2(
            dispatchThreadId.x,
            dispatchThreadId.y
        )
        *
        _SampleSpacing;

    float worldTolerance =
        max(
            abs(_SampleSpacing) *
                0.001,
            0.00001
        );

    if (
        sampleWorldXZ.x <
            -worldTolerance
        ||
        sampleWorldXZ.y <
            -worldTolerance
        ||
        sampleWorldXZ.x >
            _WorldSizeXZ.x +
            worldTolerance
        ||
        sampleWorldXZ.y >
            _WorldSizeXZ.y +
            worldTolerance
    )
    {
        return false;
    }

    cacheAddress =
        uint3(
            dispatchThreadId.x,
            dispatchThreadId.y,
            (uint)_TargetSlice
        );

    return true;
}


// =====================================================
// STAGE 13A IDENTITY COMPOSITION
// =====================================================

[numthreads(8, 8, 1)]
void IdentityComposite(
    uint3 dispatchThreadId :
        SV_DispatchThreadID
)
{
    uint3 cacheAddress;
    float2 sampleWorldXZ;

    if (
        !TryGetAuthoringSample(
            dispatchThreadId,
            cacheAddress,
            sampleWorldXZ
        )
    )
    {
        return;
    }

    float height =
        _HeightCache[
            cacheAddress
        ];

    _HeightCache[
        cacheAddress
    ] =
        height;
}


// =====================================================
// STAGE 13B ADDITIVE HEIGHT STAMP
// =====================================================

[numthreads(8, 8, 1)]
void ApplyAdditiveStamp(
    uint3 dispatchThreadId :
        SV_DispatchThreadID
)
{
    uint3 cacheAddress;
    float2 sampleWorldXZ;

    if (
        !TryGetAuthoringSample(
            dispatchThreadId,
            cacheAddress,
            sampleWorldXZ
        )
    )
    {
        return;
    }

    if (
        _StampSizeXZ.x <= 0.0
        ||
        _StampSizeXZ.y <= 0.0
    )
    {
        return;
    }

    float2 stampUV =
        (
            sampleWorldXZ -
            _StampMinXZ
        )
        /
        _StampSizeXZ;

    /*
     * Do not clamp outside samples to the texture border.
     * Outside the mathematical stamp rectangle, contribution is zero.
     */
    if (
        stampUV.x < 0.0
        ||
        stampUV.x > 1.0
        ||
        stampUV.y < 0.0
        ||
        stampUV.y > 1.0
    )
    {
        return;
    }

    /*
     * Stage 13B texture semantics:
     * 0 = no contribution
     * 1 = complete HeightDelta contribution
     *
     * Explicit mip 0 avoids mip-dependent authoring results.
     */
    float stampWeight =
        _StampTexture.SampleLevel(
            sampler_StampTexture,
            stampUV,
            0.0
        ).r;

    float contribution =
        stampWeight *
        _StampHeightDelta;

    _HeightCache[
        cacheAddress
    ] +=
        contribution;
}


// =====================================================
// STAGE 13A VALIDATION
// =====================================================

[numthreads(8, 8, 1)]
void ValidationAddConstant(
    uint3 dispatchThreadId :
        SV_DispatchThreadID
)
{
    if (
        dispatchThreadId.x >=
            (uint)_SamplesPerSide
        ||
        dispatchThreadId.y >=
            (uint)_SamplesPerSide
    )
    {
        return;
    }

    uint3 cacheAddress =
        uint3(
            dispatchThreadId.x,
            dispatchThreadId.y,
            (uint)_TargetSlice
        );

    _HeightCache[
        cacheAddress
    ] +=
        _ValidationHeightDelta;
}
