#pragma kernel IdentityComposite
#pragma kernel ApplyAdditiveStamp
#pragma kernel ValidationAddConstant

RWTexture2DArray<float> _HeightCache;

Texture2D<float4> _StampTexture;
SamplerState sampler_StampTexture;

int _TargetSlice;
int _SamplesPerSide;

float _SampleSpacing;
float _TileWorldSize;

int2 _TileCoordinate;
float2 _TileWorldOriginXZ;
float2 _WorldSizeXZ;

float2 _StampMinXZ;
float2 _StampSizeXZ;
float2 _StampTextureSize;
int _StampMipCount;

float _StampHeightDelta;
float _StampFalloff;
float _StampSmoothingRadius;
float _StampSmoothingStrength;

float _ValidationHeightDelta;


// =====================================================
// COMMON ADDRESSING
// =====================================================

bool TryGetAuthoringSample(
    uint3 dispatchThreadId,
    out uint3 cacheAddress,
    out float2 sampleWorldXZ
)
{
    cacheAddress =
        uint3(
            0,
            0,
            0
        );

    sampleWorldXZ =
        float2(
            0.0,
            0.0
        );

    if (
        dispatchThreadId.x >= (uint)_SamplesPerSide
        || dispatchThreadId.y >= (uint)_SamplesPerSide
    )
    {
        return false;
    }

    float2 expectedTileOriginXZ =
        (float2)_TileCoordinate *
        _TileWorldSize;

    float originTolerance =
        max(
            abs(_SampleSpacing) * 0.001,
            0.00001
        );

    if (
        any(
            abs(
                expectedTileOriginXZ -
                _TileWorldOriginXZ
            ) > originTolerance
        )
    )
    {
        return false;
    }

    sampleWorldXZ =
        _TileWorldOriginXZ
        + float2(
            dispatchThreadId.x,
            dispatchThreadId.y
        ) * _SampleSpacing;

    float worldTolerance =
        max(
            abs(_SampleSpacing) * 0.001,
            0.00001
        );

    if (
        sampleWorldXZ.x < -worldTolerance
        || sampleWorldXZ.y < -worldTolerance
        || sampleWorldXZ.x > _WorldSizeXZ.x + worldTolerance
        || sampleWorldXZ.y > _WorldSizeXZ.y + worldTolerance
    )
    {
        return false;
    }

    cacheAddress =
        uint3(
            dispatchThreadId.x,
            dispatchThreadId.y,
            (uint)_TargetSlice
        );

    return true;
}


// =====================================================
// IDENTITY COMPOSITION
// =====================================================

[numthreads(8, 8, 1)]
void IdentityComposite(
    uint3 dispatchThreadId : SV_DispatchThreadID
)
{
    uint3 cacheAddress;
    float2 sampleWorldXZ;

    if (
        !TryGetAuthoringSample(
            dispatchThreadId,
            cacheAddress,
            sampleWorldXZ
        )
    )
    {
        return;
    }

    float height =
        _HeightCache[
            cacheAddress
        ];

    _HeightCache[
        cacheAddress
    ] = height;
}


// =====================================================
// ADDITIVE HEIGHT STAMP
// =====================================================

float CalculateFootprintFalloff(
    float2 stampUV
)
{
    if (_StampFalloff <= 0.0)
    {
        return 1.0;
    }

    float nearestEdge =
        min(
            min(
                stampUV.x,
                1.0 - stampUV.x
            ),
            min(
                stampUV.y,
                1.0 - stampUV.y
            )
        );

    float edgeDistance01 =
        saturate(
            nearestEdge * 2.0
        );

    return
        smoothstep(
            0.0,
            saturate(_StampFalloff),
            edgeDistance01
        );
}

float SampleStampWeightAtExactLod(
    float2 stampUV,
    float lod
)
{
    return
        saturate(
            _StampTexture.SampleLevel(
                sampler_StampTexture,
                stampUV,
                lod
            ).r
        );
}

float SampleRawStampWeight(
    float2 stampUV
)
{
    return
        SampleStampWeightAtExactLod(
            stampUV,
            0.0
        );
}

float GetGaussianWeight1D(
    int coordinate
)
{
    int distance =
        abs(
            coordinate
        );

    if (distance == 0)
    {
        return 6.0;
    }

    if (distance == 1)
    {
        return 4.0;
    }

    return 1.0;
}

float CalculateAdaptiveSmoothingLod()
{
    float maxLod =
        max(
            (float)(_StampMipCount - 1),
            0.0
        );

    if (
        maxLod <= 0.0
        || _StampSmoothingRadius <= 0.0
    )
    {
        return 0.0;
    }

    float2 safeTextureSize =
        max(
            _StampTextureSize,
            float2(
                1.0,
                1.0
            )
        );

    float2 safeStampSize =
        max(
            _StampSizeXZ,
            float2(
                0.000001,
                0.000001
            )
        );

    float2 sourceTexelWorldSize =
        safeStampSize /
        safeTextureSize;

    float2 radiusInTexels =
        _StampSmoothingRadius /
        max(
            sourceTexelWorldSize,
            float2(
                0.000001,
                0.000001
            )
        );

    float coarsestRadiusInTexels =
        max(
            radiusInTexels.x,
            radiusInTexels.y
        );

    /*
     * Keep the physical Radius represented by roughly four texels at the
     * selected prefiltered scale. Small radii naturally resolve to mip 0;
     * large radii move into increasingly broad source mip levels.
     */
    const float TargetRadiusTexels =
        4.0;

    float lod =
        log2(
            max(
                coarsestRadiusInTexels /
                    TargetRadiusTexels,
                1.0
            )
        );

    return
        clamp(
            lod,
            0.0,
            maxLod
        );
}

float SampleStampWeightAtAdaptiveLod(
    float2 stampUV,
    float lod
)
{
    float maxLod =
        max(
            (float)(_StampMipCount - 1),
            0.0
        );

    float safeLod =
        clamp(
            lod,
            0.0,
            maxLod
        );

    float lowerLod =
        floor(
            safeLod
        );

    float upperLod =
        min(
            lowerLod + 1.0,
            maxLod
        );

    float lowerWeight =
        SampleStampWeightAtExactLod(
            stampUV,
            lowerLod
        );

    float mipBlend =
        safeLod -
        lowerLod;

    /*
     * The stamp importer remains Bilinear, giving deterministic filtering
     * inside each numeric mip level. Blend adjacent levels explicitly so a
     * continuously changing Radius never creates integer-LOD transitions.
     */
    if (
        mipBlend <= 0.0001
        || upperLod <= lowerLod
    )
    {
        return lowerWeight;
    }

    float upperWeight =
        SampleStampWeightAtExactLod(
            stampUV,
            upperLod
        );

    return
        saturate(
            lerp(
                lowerWeight,
                upperWeight,
                mipBlend
            )
        );
}

float SampleGaussianStampWeight(
    float2 stampUV
)
{
    float safeSizeX =
        max(
            _StampSizeXZ.x,
            0.000001
        );

    float safeSizeZ =
        max(
            _StampSizeXZ.y,
            0.000001
        );

    /*
     * Radius remains authored in WORLD METRES and the five Gaussian positions
     * remain -R, -R/2, 0, +R/2, +R. The adaptive mip level changes only how
     * much source information each tap represents.
     */
    float2 radiusUV =
        float2(
            _StampSmoothingRadius /
                safeSizeX,
            _StampSmoothingRadius /
                safeSizeZ
        );

    float smoothingLod =
        CalculateAdaptiveSmoothingLod();

    float accumulatedValue =
        0.0;

    float accumulatedWeight =
        0.0;

    [unroll]
    for (
        int offsetZ = -2;
        offsetZ <= 2;
        offsetZ++
    )
    {
        float zFactor =
            (float)offsetZ *
            0.5;

        float weightZ =
            GetGaussianWeight1D(
                offsetZ
            );

        [unroll]
        for (
            int offsetX = -2;
            offsetX <= 2;
            offsetX++
        )
        {
            float xFactor =
                (float)offsetX *
                0.5;

            /*
             * Preserve the Stage 16A ridge fix: all 25 Gaussian weights remain
             * active and only source lookup UVs clamp at the stamp boundary.
             */
            float2 sampleUV =
                saturate(
                    stampUV
                    +
                    float2(
                        radiusUV.x *
                            xFactor,
                        radiusUV.y *
                            zFactor
                    )
                );

            float weight =
                GetGaussianWeight1D(
                    offsetX
                )
                *
                weightZ;

            accumulatedValue +=
                SampleStampWeightAtAdaptiveLod(
                    sampleUV,
                    smoothingLod
                )
                *
                weight;

            accumulatedWeight +=
                weight;
        }
    }

    if (accumulatedWeight <= 0.0)
    {
        return
            SampleRawStampWeight(
                stampUV
            );
    }

    return
        saturate(
            accumulatedValue /
            accumulatedWeight
        );
}

float SampleFinalStampTextureWeight(
    float2 stampUV
)
{
    float rawWeight =
        SampleRawStampWeight(
            stampUV
        );

    /*
     * Exact legacy fast path. Radius == 0 or Strength == 0 performs the raw
     * mip-0 sample and incurs no adaptive Gaussian work.
     */
    if (
        _StampSmoothingRadius <= 0.0
        || _StampSmoothingStrength <= 0.0
    )
    {
        return rawWeight;
    }

    float smoothedWeight =
        SampleGaussianStampWeight(
            stampUV
        );

    return
        saturate(
            lerp(
                rawWeight,
                smoothedWeight,
                saturate(
                    _StampSmoothingStrength
                )
            )
        );
}

[numthreads(8, 8, 1)]
void ApplyAdditiveStamp(
    uint3 dispatchThreadId : SV_DispatchThreadID
)
{
    uint3 cacheAddress;
    float2 sampleWorldXZ;

    if (
        !TryGetAuthoringSample(
            dispatchThreadId,
            cacheAddress,
            sampleWorldXZ
        )
    )
    {
        return;
    }

    if (
        _StampSizeXZ.x <= 0.0
        || _StampSizeXZ.y <= 0.0
    )
    {
        return;
    }

    float2 stampUV =
        (
            sampleWorldXZ -
            _StampMinXZ
        ) /
        _StampSizeXZ;

    if (
        stampUV.x < 0.0
        || stampUV.x > 1.0
        || stampUV.y < 0.0
        || stampUV.y > 1.0
    )
    {
        return;
    }

    /*
     * Smoothing changes only source texture weight. The established footprint
     * Falloff remains afterward, preserving modifier bounds and edge behavior.
     */
    float textureWeight =
        SampleFinalStampTextureWeight(
            stampUV
        );

    float footprintFalloff =
        CalculateFootprintFalloff(
            stampUV
        );

    float finalWeight =
        saturate(
            textureWeight
        )
        *
        footprintFalloff;

    float contribution =
        finalWeight *
        _StampHeightDelta;

    _HeightCache[
        cacheAddress
    ] += contribution;
}


// =====================================================
// VALIDATION WRITE
// =====================================================

[numthreads(8, 8, 1)]
void ValidationAddConstant(
    uint3 dispatchThreadId : SV_DispatchThreadID
)
{
    if (
        dispatchThreadId.x >= (uint)_SamplesPerSide
        || dispatchThreadId.y >= (uint)_SamplesPerSide
    )
    {
        return;
    }

    uint3 cacheAddress =
        uint3(
            dispatchThreadId.x,
            dispatchThreadId.y,
            (uint)_TargetSlice
        );

    _HeightCache[
        cacheAddress
    ] += _ValidationHeightDelta;
}
