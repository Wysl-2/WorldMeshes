#pragma kernel IdentityComposite
#pragma kernel ApplyAdditiveStamp
#pragma kernel ValidationAddConstant

RWTexture2DArray<float> _HeightCache;

Texture2D<float4> _StampTexture;
SamplerState sampler_StampTexture;

int _TargetSlice;
int _SamplesPerSide;

float _SampleSpacing;
float _TileWorldSize;

int2 _TileCoordinate;
float2 _TileWorldOriginXZ;
float2 _WorldSizeXZ;

float2 _StampCenterXZ;
float2 _StampRightXZ;
float2 _StampForwardXZ;
float2 _StampSizeXZ;
float2 _StampTextureSize;
int _StampMipCount;
int _StampFlipX;
int _StampFlipZ;

float _StampSourceInputMin;
float _StampSourceInputMax;
float _StampSourceGamma;

float _StampHeightDelta;
float _StampFalloff;
int _StampFalloffShape;
int _StampFalloffProfile;
float _StampSmoothingRadius;
float _StampSmoothingStrength;

float _ValidationHeightDelta;


// =====================================================
// COMMON ADDRESSING
// =====================================================

bool TryGetAuthoringSample(
    uint3 dispatchThreadId,
    out uint3 cacheAddress,
    out float2 sampleWorldXZ
)
{
    cacheAddress =
        uint3(
            0,
            0,
            0
        );

    sampleWorldXZ =
        float2(
            0.0,
            0.0
        );

    if (
        dispatchThreadId.x >= (uint)_SamplesPerSide
        || dispatchThreadId.y >= (uint)_SamplesPerSide
    )
    {
        return false;
    }

    float2 expectedTileOriginXZ =
        (float2)_TileCoordinate *
        _TileWorldSize;

    float originTolerance =
        max(
            abs(_SampleSpacing) * 0.001,
            0.00001
        );

    if (
        any(
            abs(
                expectedTileOriginXZ -
                _TileWorldOriginXZ
            ) > originTolerance
        )
    )
    {
        return false;
    }

    sampleWorldXZ =
        _TileWorldOriginXZ
        + float2(
            dispatchThreadId.x,
            dispatchThreadId.y
        ) * _SampleSpacing;

    float worldTolerance =
        max(
            abs(_SampleSpacing) * 0.001,
            0.00001
        );

    if (
        sampleWorldXZ.x < -worldTolerance
        || sampleWorldXZ.y < -worldTolerance
        || sampleWorldXZ.x > _WorldSizeXZ.x + worldTolerance
        || sampleWorldXZ.y > _WorldSizeXZ.y + worldTolerance
    )
    {
        return false;
    }

    cacheAddress =
        uint3(
            dispatchThreadId.x,
            dispatchThreadId.y,
            (uint)_TargetSlice
        );

    return true;
}


// =====================================================
// IDENTITY COMPOSITION
// =====================================================

[numthreads(8, 8, 1)]
void IdentityComposite(
    uint3 dispatchThreadId : SV_DispatchThreadID
)
{
    uint3 cacheAddress;
    float2 sampleWorldXZ;

    if (
        !TryGetAuthoringSample(
            dispatchThreadId,
            cacheAddress,
            sampleWorldXZ
        )
    )
    {
        return;
    }

    float height =
        _HeightCache[
            cacheAddress
        ];

    _HeightCache[
        cacheAddress
    ] = height;
}


// =====================================================
// ADDITIVE HEIGHT STAMP
// =====================================================

float CalculateRectangleFalloffEdgeDistance01(
    float2 stampUV
)
{
    float nearestEdge =
        min(
            min(
                stampUV.x,
                1.0 - stampUV.x
            ),
            min(
                stampUV.y,
                1.0 - stampUV.y
            )
        );

    return
        saturate(
            nearestEdge * 2.0
        );
}

bool TryCalculateEllipseFalloffEdgeDistance01(
    float2 stampUV,
    out float edgeDistance01
)
{
    float2 centered =
        (
            stampUV -
            0.5
        )
        *
        2.0;

    float ellipseRadius =
        length(
            centered
        );

    if (ellipseRadius > 1.0)
    {
        edgeDistance01 =
            0.0;

        return false;
    }

    edgeDistance01 =
        saturate(
            1.0 -
            ellipseRadius
        );

    return true;
}

float EvaluateFalloffProfile(
    float transition
)
{
    float t =
        saturate(
            transition
        );

    /*
     * Linear = 1, Sharp = 2. Unknown values fall back to Smooth = 0.
     */
    if (_StampFalloffProfile == 1)
    {
        return t;
    }

    if (_StampFalloffProfile == 2)
    {
        float inverse =
            1.0 -
            t;

        return
            saturate(
                1.0 -
                inverse *
                inverse
            );
    }

    return
        saturate(
            t *
            t *
            (
                3.0 -
                2.0 *
                t
            )
        );
}

float CalculateFootprintFalloff(
    float2 stampUV
)
{
    float edgeDistance01;

    /*
     * Ellipse = 1. Unknown Shape values fall back to Rectangle = 0.
     */
    if (_StampFalloffShape == 1)
    {
        if (
            !TryCalculateEllipseFalloffEdgeDistance01(
                stampUV,
                edgeDistance01
            )
        )
        {
            return 0.0;
        }
    }
    else
    {
        edgeDistance01 =
            CalculateRectangleFalloffEdgeDistance01(
                stampUV
            );
    }

    /*
     * Shape membership is already known here. Falloff=0 therefore produces
     * a hard Rectangle or hard Ellipse without filling Ellipse corners.
     */
    float safeFalloff =
        saturate(
            _StampFalloff
        );

    if (safeFalloff <= 0.0)
    {
        return 1.0;
    }

    float transition =
        saturate(
            edgeDistance01 /
            safeFalloff
        );

    return
        saturate(
            EvaluateFalloffProfile(
                transition
            )
        );
}

float2 CalculateStampSourceUV(
    float2 stampUV
)
{
    float2 sourceUV =
        stampUV;

    if (_StampFlipX != 0)
    {
        sourceUV.x =
            1.0 -
            sourceUV.x;
    }

    if (_StampFlipZ != 0)
    {
        sourceUV.y =
            1.0 -
            sourceUV.y;
    }

    return sourceUV;
}


float SampleStampWeightAtExactLod(
    float2 stampUV,
    float lod
)
{
    return
        saturate(
            _StampTexture.SampleLevel(
                sampler_StampTexture,
                stampUV,
                lod
            ).r
        );
}

float SampleRawStampWeight(
    float2 stampUV
)
{
    return
        SampleStampWeightAtExactLod(
            stampUV,
            0.0
        );
}

float GetGaussianWeight1D(
    int coordinate
)
{
    int distance =
        abs(
            coordinate
        );

    if (distance == 0)
    {
        return 6.0;
    }

    if (distance == 1)
    {
        return 4.0;
    }

    return 1.0;
}

float CalculateAdaptiveSmoothingLod()
{
    float maxLod =
        max(
            (float)(_StampMipCount - 1),
            0.0
        );

    if (
        maxLod <= 0.0
        || _StampSmoothingRadius <= 0.0
    )
    {
        return 0.0;
    }

    float2 safeTextureSize =
        max(
            _StampTextureSize,
            float2(
                1.0,
                1.0
            )
        );

    float2 safeStampSize =
        max(
            _StampSizeXZ,
            float2(
                0.000001,
                0.000001
            )
        );

    float2 sourceTexelWorldSize =
        safeStampSize /
        safeTextureSize;

    float2 radiusInTexels =
        _StampSmoothingRadius /
        max(
            sourceTexelWorldSize,
            float2(
                0.000001,
                0.000001
            )
        );

    float coarsestRadiusInTexels =
        max(
            radiusInTexels.x,
            radiusInTexels.y
        );

    /*
     * Keep the physical Radius represented by roughly four texels at the
     * selected prefiltered scale. Small radii naturally resolve to mip 0;
     * large radii move into increasingly broad source mip levels.
     */
    const float TargetRadiusTexels =
        4.0;

    float lod =
        log2(
            max(
                coarsestRadiusInTexels /
                    TargetRadiusTexels,
                1.0
            )
        );

    return
        clamp(
            lod,
            0.0,
            maxLod
        );
}

float SampleStampWeightAtAdaptiveLod(
    float2 stampUV,
    float lod
)
{
    float maxLod =
        max(
            (float)(_StampMipCount - 1),
            0.0
        );

    float safeLod =
        clamp(
            lod,
            0.0,
            maxLod
        );

    float lowerLod =
        floor(
            safeLod
        );

    float upperLod =
        min(
            lowerLod + 1.0,
            maxLod
        );

    float lowerWeight =
        SampleStampWeightAtExactLod(
            stampUV,
            lowerLod
        );

    float mipBlend =
        safeLod -
        lowerLod;

    /*
     * The stamp importer remains Bilinear, giving deterministic filtering
     * inside each numeric mip level. Blend adjacent levels explicitly so a
     * continuously changing Radius never creates integer-LOD transitions.
     */
    if (
        mipBlend <= 0.0001
        || upperLod <= lowerLod
    )
    {
        return lowerWeight;
    }

    float upperWeight =
        SampleStampWeightAtExactLod(
            stampUV,
            upperLod
        );

    return
        saturate(
            lerp(
                lowerWeight,
                upperWeight,
                mipBlend
            )
        );
}

float SampleGaussianStampWeight(
    float2 stampUV
)
{
    float safeSizeX =
        max(
            _StampSizeXZ.x,
            0.000001
        );

    float safeSizeZ =
        max(
            _StampSizeXZ.y,
            0.000001
        );

    /*
     * Radius remains authored in WORLD METRES and the five Gaussian positions
     * remain -R, -R/2, 0, +R/2, +R. The adaptive mip level changes only how
     * much source information each tap represents.
     */
    float2 radiusUV =
        float2(
            _StampSmoothingRadius /
                safeSizeX,
            _StampSmoothingRadius /
                safeSizeZ
        );

    float smoothingLod =
        CalculateAdaptiveSmoothingLod();

    float accumulatedValue =
        0.0;

    float accumulatedWeight =
        0.0;

    [unroll]
    for (
        int offsetZ = -2;
        offsetZ <= 2;
        offsetZ++
    )
    {
        float zFactor =
            (float)offsetZ *
            0.5;

        float weightZ =
            GetGaussianWeight1D(
                offsetZ
            );

        [unroll]
        for (
            int offsetX = -2;
            offsetX <= 2;
            offsetX++
        )
        {
            float xFactor =
                (float)offsetX *
                0.5;

            /*
             * Preserve the Stage 16A ridge fix: all 25 Gaussian weights remain
             * active and only source lookup UVs clamp at the stamp boundary.
             */
            float2 sampleUV =
                saturate(
                    stampUV
                    +
                    float2(
                        radiusUV.x *
                            xFactor,
                        radiusUV.y *
                            zFactor
                    )
                );

            float weight =
                GetGaussianWeight1D(
                    offsetX
                )
                *
                weightZ;

            accumulatedValue +=
                SampleStampWeightAtAdaptiveLod(
                    sampleUV,
                    smoothingLod
                )
                *
                weight;

            accumulatedWeight +=
                weight;
        }
    }

    if (accumulatedWeight <= 0.0)
    {
        return
            SampleRawStampWeight(
                stampUV
            );
    }

    return
        saturate(
            accumulatedValue /
            accumulatedWeight
        );
}

float SampleFinalStampTextureWeight(
    float2 stampUV
)
{
    float rawWeight =
        SampleRawStampWeight(
            stampUV
        );

    /*
     * Exact legacy fast path. Radius == 0 or Strength == 0 performs the raw
     * mip-0 sample and incurs no adaptive Gaussian work.
     */
    if (
        _StampSmoothingRadius <= 0.0
        || _StampSmoothingStrength <= 0.0
    )
    {
        return rawWeight;
    }

    float smoothedWeight =
        SampleGaussianStampWeight(
            stampUV
        );

    return
        saturate(
            lerp(
                rawWeight,
                smoothedWeight,
                saturate(
                    _StampSmoothingStrength
                )
            )
        );
}

/*
 * Source response is deliberately AFTER SampleFinalStampTextureWeight().
 * Smoothing owns spatial/source filtering; this function owns only the
 * interpretation of the resulting normalized source value.
 */
float RemapStampSourceWeight(
    float sourceWeight
)
{
    float safeSourceWeight =
        saturate(
            sourceWeight
        );

    /*
     * Identity is the overwhelmingly common compatibility path for existing
     * stamps and avoids pow() when no remapping is authored.
     */
    if (
        abs(
            _StampSourceInputMin
        ) <= 0.000001
        &&
        abs(
            _StampSourceInputMax -
            1.0
        ) <= 0.000001
        &&
        abs(
            _StampSourceGamma -
            1.0
        ) <= 0.000001
    )
    {
        return safeSourceWeight;
    }

    float safeRange =
        max(
            _StampSourceInputMax -
                _StampSourceInputMin,
            0.000001
        );

    float normalizedWeight =
        saturate(
            (
                safeSourceWeight -
                    _StampSourceInputMin
            )
            /
            safeRange
        );

    return
        saturate(
            pow(
                normalizedWeight,
                max(
                    _StampSourceGamma,
                    0.000001
                )
            )
        );
}

[numthreads(8, 8, 1)]
void ApplyAdditiveStamp(
    uint3 dispatchThreadId : SV_DispatchThreadID
)
{
    uint3 cacheAddress;
    float2 sampleWorldXZ;

    if (
        !TryGetAuthoringSample(
            dispatchThreadId,
            cacheAddress,
            sampleWorldXZ
        )
    )
    {
        return;
    }

    if (
        _StampSizeXZ.x <= 0.0
        || _StampSizeXZ.y <= 0.0
    )
    {
        return;
    }

    float2 stampDelta =
        sampleWorldXZ -
        _StampCenterXZ;

    /*
     * Convert the absolute world sample into the stamp's oriented local XZ
     * frame. Right/Forward are calculated once on the CPU from the shared
     * TerrainStampTransformUtility convention and supplied as an orthonormal
     * basis.
     */
    float2 stampLocalXZ =
        float2(
            dot(
                stampDelta,
                _StampRightXZ
            ),
            dot(
                stampDelta,
                _StampForwardXZ
            )
        );

    float2 stampUV =
        stampLocalXZ /
        _StampSizeXZ
        +
        0.5;

    if (
        stampUV.x < 0.0
        || stampUV.x > 1.0
        || stampUV.y < 0.0
        || stampUV.y > 1.0
    )
    {
        return;
    }

    /*
     * stampUV remains the spatial footprint coordinate. Source orientation is
     * derived separately so mirroring affects texture/smoothing lookup only,
     * never footprint inclusion, Falloff, Bounds, or Scene geometry.
     */
    float2 sourceUV =
        CalculateStampSourceUV(
            stampUV
        );

    /*
     * Smoothing changes only source texture weight. Source remapping then
     * interprets that final filtered source value. The established footprint
     * Falloff remains spatial and continues to use stampUV.
     */
    float sourceWeight =
        SampleFinalStampTextureWeight(
            sourceUV
        );

    float remappedWeight =
        RemapStampSourceWeight(
            sourceWeight
        );

    float footprintFalloff =
        CalculateFootprintFalloff(
            stampUV
        );

    float finalWeight =
        saturate(
            remappedWeight
        )
        *
        footprintFalloff;

    float contribution =
        finalWeight *
        _StampHeightDelta;

    _HeightCache[
        cacheAddress
    ] += contribution;
}


// =====================================================
// VALIDATION WRITE
// =====================================================

[numthreads(8, 8, 1)]
void ValidationAddConstant(
    uint3 dispatchThreadId : SV_DispatchThreadID
)
{
    if (
        dispatchThreadId.x >= (uint)_SamplesPerSide
        || dispatchThreadId.y >= (uint)_SamplesPerSide
    )
    {
        return;
    }

    uint3 cacheAddress =
        uint3(
            dispatchThreadId.x,
            dispatchThreadId.y,
            (uint)_TargetSlice
        );

    _HeightCache[
        cacheAddress
    ] += _ValidationHeightDelta;
}
