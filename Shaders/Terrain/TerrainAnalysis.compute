#pragma kernel GenerateSlope
#pragma kernel GenerateCurvature
#pragma kernel GenerateRoughness
#pragma kernel GenerateLocalRelief

#include "Assets/WorldMeshes/Shaders/Terrain/TerrainAnalysisCommon.hlsl"

Texture2DArray<float> _HeightCache;
RWTexture2DArray<float> _AnalysisOutput;

int2 _HeightCacheOriginTile;
int2 _HeightCacheSize;

int _SamplesPerSide;

float _SampleSpacing;
float2 _WorldSizeXZ;

float _AnalysisScaleMeters;

/*
 * Full generation sets this to zero and dispatches every slice.
 * Incremental generation sets this to the first target slice and dispatches
 * only one or more contiguous requested slices.
 */
int _OutputSliceOffset;


// =========================================================
// HEIGHT CACHE ADDRESSING
// =========================================================

bool TrySampleTerrainHeight(
    float2 worldXZ,
    out float height
)
{
    height = 0.0;

    if (
        _HeightCacheSize.x <= 0 ||
        _HeightCacheSize.y <= 0 ||
        _SamplesPerSide <= 1 ||
        _SampleSpacing <= 0.0 ||
        _WorldSizeXZ.x <= 0.0 ||
        _WorldSizeXZ.y <= 0.0
    )
    {
        return false;
    }

    float spacing =
        max(
            _SampleSpacing,
            0.000001
        );

    int tileIntervals =
        _SamplesPerSide -
        1;

    float2 clampedWorldXZ =
        clamp(
            worldXZ,
            float2(0.0, 0.0),
            _WorldSizeXZ
        );

    int2 globalSample =
        (int2)floor(
            clampedWorldXZ /
            spacing +
            0.5
        );

    int2 worldMaxSample =
        (int2)floor(
            _WorldSizeXZ /
            spacing +
            0.5
        );

    int2 totalTileCount =
        (
            worldMaxSample +
            tileIntervals -
            1
        )
        /
        tileIntervals;

    totalTileCount =
        max(
            totalTileCount,
            int2(1, 1)
        );

    int2 tileCoordinate =
        globalSample /
        tileIntervals;

    tileCoordinate =
        min(
            tileCoordinate,
            totalTileCount - 1
        );

    int2 localSample =
        globalSample -
        tileCoordinate *
        tileIntervals;

    int2 cacheLocalTile =
        tileCoordinate -
        _HeightCacheOriginTile;

    if (
        cacheLocalTile.x < 0 ||
        cacheLocalTile.y < 0 ||
        cacheLocalTile.x >= _HeightCacheSize.x ||
        cacheLocalTile.y >= _HeightCacheSize.y
    )
    {
        return false;
    }

    int slice =
        cacheLocalTile.x +
        cacheLocalTile.y *
        _HeightCacheSize.x;

    height =
        _HeightCache.Load(
            int4(
                localSample.x,
                localSample.y,
                slice,
                0
            )
        );

    return true;
}


bool TryGetOutputSample(
    uint3 dispatchThreadId,
    out uint3 outputAddress,
    out float2 worldXZ,
    out float centerHeight
)
{
    outputAddress = uint3(0, 0, 0);
    worldXZ = float2(0.0, 0.0);
    centerHeight = 0.0;

    if (
        dispatchThreadId.x >= (uint)_SamplesPerSide ||
        dispatchThreadId.y >= (uint)_SamplesPerSide
    )
    {
        return false;
    }

    int sliceCount =
        _HeightCacheSize.x *
        _HeightCacheSize.y;

    int slice =
        _OutputSliceOffset +
        (int)dispatchThreadId.z;

    if (
        slice < 0 ||
        slice >= sliceCount
    )
    {
        return false;
    }

    int2 cacheLocalTile =
        int2(
            slice % _HeightCacheSize.x,
            slice / _HeightCacheSize.x
        );

    int2 tileCoordinate =
        _HeightCacheOriginTile +
        cacheLocalTile;

    int tileIntervals =
        _SamplesPerSide -
        1;

    float tileWorldSize =
        tileIntervals *
        _SampleSpacing;

    worldXZ =
        (float2)tileCoordinate *
        tileWorldSize +
        float2(
            dispatchThreadId.x,
            dispatchThreadId.y
        )
        *
        _SampleSpacing;

    float worldTolerance =
        max(
            abs(_SampleSpacing) *
            0.001,
            0.00001
        );

    if (
        worldXZ.x < -worldTolerance ||
        worldXZ.y < -worldTolerance ||
        worldXZ.x > _WorldSizeXZ.x + worldTolerance ||
        worldXZ.y > _WorldSizeXZ.y + worldTolerance
    )
    {
        return false;
    }

    if (
        !TrySampleTerrainHeight(
            worldXZ,
            centerHeight
        )
    )
    {
        return false;
    }

    outputAddress =
        uint3(
            dispatchThreadId.x,
            dispatchThreadId.y,
            (uint)slice
        );

    return true;
}


// =========================================================
// SHARED NEIGHBOUR SAMPLING
// =========================================================

void SampleHeightOrCenter(
    float2 worldXZ,
    float2 offset,
    float centerHeight,
    out float height
)
{
    if (
        !TrySampleTerrainHeight(
            worldXZ +
            offset,
            height
        )
    )
    {
        height =
            centerHeight;
    }
}


void SampleFourNeighbours(
    float2 worldXZ,
    float centerHeight,
    float radius,
    out float heightLeft,
    out float heightRight,
    out float heightBack,
    out float heightForward
)
{
    SampleHeightOrCenter(
        worldXZ,
        float2(-radius, 0.0),
        centerHeight,
        heightLeft
    );

    SampleHeightOrCenter(
        worldXZ,
        float2(radius, 0.0),
        centerHeight,
        heightRight
    );

    SampleHeightOrCenter(
        worldXZ,
        float2(0.0, -radius),
        centerHeight,
        heightBack
    );

    SampleHeightOrCenter(
        worldXZ,
        float2(0.0, radius),
        centerHeight,
        heightForward
    );
}


float GetAnalysisRadius()
{
    return
        max(
            _AnalysisScaleMeters,
            max(
                _SampleSpacing,
                0.000001
            )
        );
}


// =========================================================
// SLOPE
// =========================================================

float CalculateSlopeDegrees(
    float2 worldXZ,
    float centerHeight
)
{
    float spacing =
        max(
            _SampleSpacing,
            0.000001
        );

    float heightLeft;
    float heightRight;
    float heightBack;
    float heightForward;

    SampleFourNeighbours(
        worldXZ,
        centerHeight,
        spacing,
        heightLeft,
        heightRight,
        heightBack,
        heightForward
    );

    float3 normalWS =
        normalize(
            float3(
                heightLeft -
                heightRight,

                2.0 *
                spacing,

                heightBack -
                heightForward
            )
        );

    return
        CalculateTerrainSlopeDegrees(
            normalWS
        );
}


[numthreads(8, 8, 1)]
void GenerateSlope(
    uint3 dispatchThreadId :
    SV_DispatchThreadID
)
{
    uint3 outputAddress;
    float2 worldXZ;
    float centerHeight;

    if (
        !TryGetOutputSample(
            dispatchThreadId,
            outputAddress,
            worldXZ,
            centerHeight
        )
    )
    {
        return;
    }

    _AnalysisOutput[
        outputAddress
    ] =
        CalculateSlopeDegrees(
            worldXZ,
            centerHeight
        );
}


// =========================================================
// CURVATURE
// =========================================================

float CalculateCurvature(
    float2 worldXZ,
    float centerHeight
)
{
    float radius =
        GetAnalysisRadius();

    float heightLeft;
    float heightRight;
    float heightBack;
    float heightForward;

    SampleFourNeighbours(
        worldXZ,
        centerHeight,
        radius,
        heightLeft,
        heightRight,
        heightBack,
        heightForward
    );

    float neighbourAverage =
        (
            heightLeft +
            heightRight +
            heightBack +
            heightForward
        )
        *
        0.25;

    return
        (
            centerHeight -
            neighbourAverage
        )
        /
        radius;
}


[numthreads(8, 8, 1)]
void GenerateCurvature(
    uint3 dispatchThreadId :
    SV_DispatchThreadID
)
{
    uint3 outputAddress;
    float2 worldXZ;
    float centerHeight;

    if (
        !TryGetOutputSample(
            dispatchThreadId,
            outputAddress,
            worldXZ,
            centerHeight
        )
    )
    {
        return;
    }

    _AnalysisOutput[
        outputAddress
    ] =
        CalculateCurvature(
            worldXZ,
            centerHeight
        );
}


// =========================================================
// ROUGHNESS
// =========================================================

/*
 * Dimensionless multi-scale roughness.
 *
 * Eight samples on a ring are compared to a local planar trend estimated
 * from the opposite cardinal samples. A perfectly planar slope therefore
 * approaches zero instead of appearing "rough" merely because it is steep.
 *
 * The RMS vertical residual is divided by radius so values remain broadly
 * comparable as the requested analysis scale changes.
 */
float CalculateRoughness(
    float2 worldXZ,
    float centerHeight
)
{
    float radius =
        GetAnalysisRadius();

    const float diagonalFactor =
        0.70710678118;

    float diagonal =
        radius *
        diagonalFactor;

    float hL;
    float hR;
    float hB;
    float hF;

    SampleFourNeighbours(
        worldXZ,
        centerHeight,
        radius,
        hL,
        hR,
        hB,
        hF
    );

    float hLB;
    float hLF;
    float hRB;
    float hRF;

    SampleHeightOrCenter(
        worldXZ,
        float2(-diagonal, -diagonal),
        centerHeight,
        hLB
    );

    SampleHeightOrCenter(
        worldXZ,
        float2(-diagonal, diagonal),
        centerHeight,
        hLF
    );

    SampleHeightOrCenter(
        worldXZ,
        float2(diagonal, -diagonal),
        centerHeight,
        hRB
    );

    SampleHeightOrCenter(
        worldXZ,
        float2(diagonal, diagonal),
        centerHeight,
        hRF
    );

    float inverseDiameter =
        1.0 /
        max(
            2.0 *
            radius,
            0.000001
        );

    float gradientX =
        (
            hR -
            hL
        )
        *
        inverseDiameter;

    float gradientZ =
        (
            hF -
            hB
        )
        *
        inverseDiameter;

    float residualL =
        hL -
        (
            centerHeight -
            gradientX *
            radius
        );

    float residualR =
        hR -
        (
            centerHeight +
            gradientX *
            radius
        );

    float residualB =
        hB -
        (
            centerHeight -
            gradientZ *
            radius
        );

    float residualF =
        hF -
        (
            centerHeight +
            gradientZ *
            radius
        );

    float residualLB =
        hLB -
        (
            centerHeight -
            gradientX *
            diagonal -
            gradientZ *
            diagonal
        );

    float residualLF =
        hLF -
        (
            centerHeight -
            gradientX *
            diagonal +
            gradientZ *
            diagonal
        );

    float residualRB =
        hRB -
        (
            centerHeight +
            gradientX *
            diagonal -
            gradientZ *
            diagonal
        );

    float residualRF =
        hRF -
        (
            centerHeight +
            gradientX *
            diagonal +
            gradientZ *
            diagonal
        );

    float meanSquaredResidual =
        (
            residualL * residualL +
            residualR * residualR +
            residualB * residualB +
            residualF * residualF +
            residualLB * residualLB +
            residualLF * residualLF +
            residualRB * residualRB +
            residualRF * residualRF
        )
        /
        8.0;

    float rmsResidual =
        sqrt(
            max(
                meanSquaredResidual,
                0.0
            )
        );

    return
        rmsResidual /
        max(
            radius,
            0.000001
        );
}


[numthreads(8, 8, 1)]
void GenerateRoughness(
    uint3 dispatchThreadId :
    SV_DispatchThreadID
)
{
    uint3 outputAddress;
    float2 worldXZ;
    float centerHeight;

    if (
        !TryGetOutputSample(
            dispatchThreadId,
            outputAddress,
            worldXZ,
            centerHeight
        )
    )
    {
        return;
    }

    _AnalysisOutput[
        outputAddress
    ] =
        CalculateRoughness(
            worldXZ,
            centerHeight
        );
}


// =========================================================
// LOCAL RELIEF
// =========================================================

/*
 * Local Relief is the local elevation range in metres:
 *
 *     max sampled height - min sampled height
 *
 * Samples lie on the same radius used by Roughness. Unlike Roughness this
 * intentionally retains broad slope/amplitude information; it answers how
 * much vertical terrain range exists around the sample, not how irregular
 * that terrain is.
 */
float CalculateLocalRelief(
    float2 worldXZ,
    float centerHeight
)
{
    float radius =
        GetAnalysisRadius();

    const float diagonalFactor =
        0.70710678118;

    float diagonal =
        radius *
        diagonalFactor;

    float hL;
    float hR;
    float hB;
    float hF;

    SampleFourNeighbours(
        worldXZ,
        centerHeight,
        radius,
        hL,
        hR,
        hB,
        hF
    );

    float hLB;
    float hLF;
    float hRB;
    float hRF;

    SampleHeightOrCenter(
        worldXZ,
        float2(-diagonal, -diagonal),
        centerHeight,
        hLB
    );

    SampleHeightOrCenter(
        worldXZ,
        float2(-diagonal, diagonal),
        centerHeight,
        hLF
    );

    SampleHeightOrCenter(
        worldXZ,
        float2(diagonal, -diagonal),
        centerHeight,
        hRB
    );

    SampleHeightOrCenter(
        worldXZ,
        float2(diagonal, diagonal),
        centerHeight,
        hRF
    );

    float minimumHeight =
        min(
            centerHeight,
            min(
                min(
                    min(hL, hR),
                    min(hB, hF)
                ),
                min(
                    min(hLB, hLF),
                    min(hRB, hRF)
                )
            )
        );

    float maximumHeight =
        max(
            centerHeight,
            max(
                max(
                    max(hL, hR),
                    max(hB, hF)
                ),
                max(
                    max(hLB, hLF),
                    max(hRB, hRF)
                )
            )
        );

    return
        max(
            0.0,
            maximumHeight -
            minimumHeight
        );
}


[numthreads(8, 8, 1)]
void GenerateLocalRelief(
    uint3 dispatchThreadId :
    SV_DispatchThreadID
)
{
    uint3 outputAddress;
    float2 worldXZ;
    float centerHeight;

    if (
        !TryGetOutputSample(
            dispatchThreadId,
            outputAddress,
            worldXZ,
            centerHeight
        )
    )
    {
        return;
    }

    _AnalysisOutput[
        outputAddress
    ] =
        CalculateLocalRelief(
            worldXZ,
            centerHeight
        );
}
